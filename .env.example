# Copy to .env and fill in.
#
# These are Terraform's native TF_VAR_* names, so they work three ways with no mapping:
#   make tf-plan                       (the Makefile exports them)
#   set -a; . ./.env; set +a           (then bare `terraform plan` works)
#   GitHub Actions                     (same names, from repository secrets)
TF_VAR_project_id=your-project-id
TF_VAR_region=europe-west2

# Not used by Terraform; recorded for reference.
GCP_PROJECT_NUMBER=000000000000

# Optional. Where GCP traffic and error alerts are emailed. Leave unset to skip creating the
# notification channel and alert policies.
# TF_VAR_alert_email=you@example.com
